<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon fallback for devices below API 26 (minSdk 24) which do not
  support adaptive icons. This single vector composes the solid emerald
  background together with the white "M" mark so the app has a proper icon on
  Android 7.0 / 7.1 as well.

  On API 26+ the more specific mipmap-anydpi-v26/ic_launcher.xml (adaptive
  icon) takes precedence, so this file is only used on older API levels.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Solid emerald background filling the whole icon. -->
    <path
        android:fillColor="#003527"
        android:pathData="M0,0h108v108h-108z" />
    <!-- White "M" mark, scaled to the centre of the canvas. -->
    <group
        android:scaleX="2.4"
        android:scaleY="2.4"
        android:translateX="18"
        android:translateY="18">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M15.47,7.1l-1.3,1.85c-0.2,0.29-0.54,0.47-0.9,0.47h-7.1V7.09C6.16,7.1,15.47,7.1,15.47,7.1z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M24.3,7.1L13.14,22.91L5.7,22.91L16.86,7.1Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M14.53,22.91l1.31-1.86c0.2-0.29,0.54-0.47,0.9-0.47h7.09v2.33H14.53z" />
    </group>
</vector>
