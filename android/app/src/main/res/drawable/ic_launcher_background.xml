<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background — a flat, solid rectangle of the brand colour
  (#003527). Implemented as a <shape> so it doubles as the launcher theme's
  windowBackground (giving a clean solid-colour splash screen).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#003527" />
</shape>
